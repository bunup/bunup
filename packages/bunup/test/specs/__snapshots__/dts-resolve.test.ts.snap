// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`dts-resolve should respect custom dts.resolve configuration 1`] = `
"interface SomeType {
	id: number;
	value: string;
}
declare function process(data: SomeType): SomeType;
export { process };
"
`;

exports[`dts-resolve should only resolve specified external packages in dts files 1`] = `
"type DateFormat = string;
import { ChalkColor } from "chalk";
type UUID = string;
declare function formatTimestamp(): string;
declare function colorize(text: string): string;
declare function generateId(): string;
export { generateId, formatTimestamp, colorize, UUID, DateFormat, ChalkColor };
"
`;

exports[`dts-resolve should prefer declaration files over source code files 1`] = `
"interface Component {
	id: number;
	name: string;
}
declare function createComponent(): Component;
export { createComponent, Component };
"
`;

exports[`dts-resolve should resolve types from dependencies listed in package.json when specified in dts.resolve 1`] = `
"interface DepType {
	id: number;
	name: string;
}
import { PeerType } from "peer-lib";
declare function useTypes(dep: DepType, peer: PeerType): {
	dep: DepType
	peer: PeerType
};
export { useTypes, PeerType, DepType };
"
`;

exports[`dts-resolve should resolve types from packages specified in both external and dts.resolve 1`] = `
"interface ExternalType {
	id: string;
	timestamp: number;
}
import { InternalType } from "internal-pkg";
declare function processData(ext: ExternalType, int: InternalType): {
	ext: ExternalType
	int: InternalType
};
export { processData, InternalType, ExternalType };
"
`;

exports[`dts-resolve should resolve all external types when dts.resolve is true 1`] = `
"interface TypeA {
	propA: string;
}
interface TypeB {
	propB: number;
}
interface TypeC {
	propC: boolean;
}
declare function combineTypes(a: TypeA, b: TypeB, c: TypeC): {
	a: TypeA
	b: TypeB
	c: TypeC
};
export { combineTypes, TypeC, TypeB, TypeA };
"
`;

exports[`dts-resolve should respect noExternal when resolving types 1`] = `
"import { ExternalType } from "external-lib";
interface IncludedType {
	name: string;
}
declare function process(ext: ExternalType, inc: IncludedType): {
	ext: ExternalType
	inc: IncludedType
};
export { process, IncludedType, ExternalType };
"
`;
